params {
  help = false

  // Output directory
  outdir = './variant-results'

  // Either input reads as a samplesheet (csv) with headings "sample","bam" or a glob pattern
  samplesheet = false
  bam = false
  // Reference genome
  reference_fasta = false
  reference_gb = false

  // Max read depth call a variant at that position, limit this so it doesn't become computational expensive
  depth=10000
  // Minimum number of reads with the same snp to count as a "variant" and not sequencing error
  // E.g. 20/10000 will call variants at a sensitivity of 0.2%
  min_depth=20

  // MPILEUP and Variant Calling ARGS
  bcftools_mpileup_args=false
  bcftools_call_args=false
  bcftools_filter_args=false
  bcftools_norm_args=false
  bcftools_merge_args=false

  bcftools_call_time='24h'
  bcftools_call_cpus=12
  bcftools_call_memory='128 GB'

  error_strategy='ignore' // 'ignore' or 'terminate'
}

profiles {
  local { }
  stjude {
    includeConfig 'configs/stjude.config'
  }
  docker {
    docker.enabled = true
    singularity.enabled = false
    apptainer.enabled = false
    podman.enabled = false
    shifter.enabled = false
    charliecloud.enabled = false
  }
  conda {
    conda.enabled = true
  }
}

process {
  publishDir = [ path: "${params.outdir}", mode: 'copy']
  errorStrategy = params.error_strategy
  withName: SAMTOOLS_FAIDX {
    publishDir = [ path: "${params.outdir}/samtools_faidx", mode: 'copy']
  }
  withName: BCFTOOLS_MPILEUP_CALL {
    publishDir = [ path: "${params.outdir}/bcftools_mpileup_call", mode: 'copy']
    ext.args = params.bcftools_mpileup_args ?: [
        "--max-depth ${params.depth}",
        "--max-idepth ${params.depth}",
        "--per-sample-mF",
        "--count-orphans",
        "--no-BAQ",
        "--min-BQ 13",
        "--min-MQ 30",
        "--annotate AD,ADF,ADR,DP,SP"
    ].join(' ')

    ext.args2 = params.bcftools_call_args ?: [
        "-mv",
        "--prior-freq AN,AC",
        "-A",
        "--variants-only",
        "--keep-alts",
        "--keep-masked-ref"
    ].join(' ')

    time = params.bcftools_call_time
    memory = params.bcftools_call_memory
    cpus = params.bcftools_call_cpus
  }
  withName: BCFTOOLS_FILLTAGS {
    publishDir = [ path: "${params.outdir}/bcftools_filltags", mode: 'copy']
  }
  withName: BCFTOOLS_FILTER {
    publishDir = [ path: "${params.outdir}/bcftools_filter", mode: 'copy']
    ext.args = params.bcftools_filter_args ?: [
        "-i 'FORMAT/DP>=${params.min_depth}'",
        "--output-type z",
        "--write-index=tbi"
    ].join(' ')
  }
  withName: BCFTOOLS_NORM {
    publishDir = [ path: "${params.outdir}/bcftools_norm", mode: 'copy']
    ext.args = params.bcftools_norm_args ?: [
      "--multiallelics",
      "-any",
      "--check-ref s",
      "--output-type z",
      "--write-index=tbi"
    ].join(' ')
  }
  withName: BCFTOOLS_MERGE {
    publishDir = [ path: "${params.outdir}/bcftools_merge", mode: 'copy']
    ext.args = params.bcftools_merge_args ?: [
      "--force-single" // Allow merging only one vcf file (for automated pipelines)
    ].join(' ')
  }
  withName: VCF_ANNOTATOR {
    publishDir = [ path: "${params.outdir}/vcfannotator", mode: 'copy']
  }
  withName: BCFTOOLS_QUERY{
    publishDir = [ path: "${params.outdir}", mode: 'copy']
  }
}

trace {
    enabled = true
    overwrite = true
    file = "$params.outdir/trace.txt"
}

manifest {
    name = 'j23414/bam-variants'
    description = "A modular workflow for generating a table of variants from alignment information."
    version = "0.0"
    mainScript = 'main.nf'
}
